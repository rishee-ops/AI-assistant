# ============================================================================
# Google Sheets Feedback Automation - Environment Configuration
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ============================================================================

# --- Authentication ---------------------------------------------------------
# Path to the Google service-account JSON key file.
# Either GOOGLE_SERVICE_ACCOUNT_FILE *or* GOOGLE_SERVICE_ACCOUNT_JSON is required.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# Alternatively, paste the entire JSON key as a single-line string (useful for
# CI / containers where mounting a file is inconvenient). Takes precedence
# over GOOGLE_SERVICE_ACCOUNT_FILE when set.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Source sheet (read-only) ----------------------------------------------
SOURCE_SPREADSHEET_ID=1-LYduNvxpbQh2uOrq3joOUC1x1q4sH4RPEfaw3gC-JE
# Identify the source worksheet by exact TITLE (preferred) OR by gid.
# The SkillArbitrage responses live in the "SA response evening" tab.
SOURCE_WORKSHEET_TITLE=SA response evening
# SOURCE_WORKSHEET_GID=994212788

# --- Destination sheet (write) ----------------------------------------------
DEST_SPREADSHEET_ID=1fMmv1rn5dJl0yQO_eusaq-es2P2fdSGyTX2YfCtuw_s
# The ONLY tab this script is ever allowed to write to. A hard guard refuses
# to write anywhere else.
DEST_WORKSHEET_TITLE=AI for Women

# --- Row matching / filtering -----------------------------------------------
# Header of the SOURCE column that names the program/course for each row.
# Matched fuzzily (case/space/punctuation-insensitive), so a trailing space or
# "?" in the real header is fine.
PROGRAM_COLUMN=Which course are you giving feedback for?
# Comma-separated, case-insensitive SUBSTRINGS. A row is relevant if its course
# contains ANY of these. Add more (e.g. SkillArbitrage) as needed.
PROGRAM_FILTER=Training Program on Using AI for Business Growth

# Header of the SOURCE column holding the raw free-text feedback to rewrite.
# If blank, the script auto-detects the best free-text feedback column.
FEEDBACK_COLUMN=We value your feedback. Please let us know more.

# Optional: header of a stable per-row identifier used for duplicate detection
# (e.g. email). If blank, a hash of the key source fields is used instead.
ROW_ID_COLUMN=Email address

# --- Feedback rewriting -----------------------------------------------------
# Engine: "anthropic" (LLM-quality rewrite) or "rule" (offline grammar cleanup).
REWRITE_ENGINE=anthropic
ANTHROPIC_API_KEY=
REWRITE_MODEL=claude-sonnet-4-6
REWRITE_MAX_TOKENS=400
# Feedback shorter than this (after trimming) and junk tokens like "NA"/"-"
# are treated as "no usable feedback" and the row is skipped.
MIN_FEEDBACK_CHARS=2

# --- Behaviour --------------------------------------------------------------
# JSON file tracking already-synced source rows so re-runs never duplicate.
STATE_FILE=./state/synced_keys.json
# "true" => log what WOULD happen without writing to the destination sheet.
DRY_RUN=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/feedback_sync.log
