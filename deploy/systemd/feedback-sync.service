[Unit]
Description=Google Sheets feedback enhancement sync (AI for Women)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --- EDIT THESE PATHS / USER ---
User=feedbacksync
WorkingDirectory=/opt/feedback-sync
# Load secrets/config from an environment file (NOT world-readable, chmod 600).
EnvironmentFile=/opt/feedback-sync/.env
ExecStart=/opt/feedback-sync/.venv/bin/python /opt/feedback-sync/main.py
# Restart policy is handled by the timer; surface failures to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
